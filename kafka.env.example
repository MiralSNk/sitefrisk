# Уникальный ID брокера внутри кластера (при одном брокере 0)
KAFKA_CFG_NODE_ID=

# Роль узла в KRaft-режиме: broker (хранит данные) и/или controller (участвует в консенсусе).
# При одном узле — обе роли через запятую: controller,broker
KAFKA_CFG_PROCESS_ROLES=

# На чём брокер физически слушает: <имя_листенера>://<адрес>:<порт>, через запятую.
KAFKA_CFG_LISTENERS=

# Адрес, который брокер сообщает клиентам для подключения — имя сервиса в docker-сети, не localhost
KAFKA_CFG_ADVERTISED_LISTENERS=

# Участники KRaft-консенсуса: <node_id>@<host>:<port>, через запятую при нескольких брокерах
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=

# Какой из листенеров (имя из LISTENERS) использовать для служебного KRaft-трафика
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=